from pathlib import Path
import re
import subprocess
import time
from pywinauto import Application

TARGET_FOLDER = Path(r"PASTE YOUR FOLDER PATH HERE WITHIN THE QUOTES")
HOLLEY_EXE = r"C:\Program Files (x86)\Holley\EFI V6\Holley.exe"


def kill_existing_holley():
    """Forces any stuck or background Holley processes to close completely."""
    try:
        subprocess.run(["taskkill", "/f", "/im", "Holley.exe"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(1.5)
    except Exception:
        pass


def unpack_dlz_files(target_dir: Path, dlz_file: Path):
    """Opens the .dlz container, waits for the decompression modal to finish, and robustly waits for all segments to write."""
    base_stem = dlz_file.stem.lower()

    existing_segments = [
        p for p in target_dir.iterdir()
        if p.is_file() and p.suffix.lower() == ".dl" and p.stem.lower().startswith(base_stem) and re.search(r'_\d+$', p.stem)
    ]

    if existing_segments:
        print(f"[INFO] Found {len(existing_segments)} existing segment files for {dlz_file.name}. Skipping unpacking.")
        return

    print(f"Found container: {dlz_file.name}. Initiating full extraction...")
    kill_existing_holley()
    
    subprocess.Popen([HOLLEY_EXE, str(dlz_file.resolve())])
    
    print("  -> Waiting for Holley decompression modal...")
    max_wait = 120
    start_wait = time.time()
    saw_decompress = False

    # Phase 1: Wait for decompression window to appear and then close
    while time.time() - start_wait < max_wait:
        time.sleep(1.0)
        try:
            from pywinauto import findwindows
            hwnds = findwindows.find_windows(visible=True)
            decompress_active = False
            for hwnd in hwnds:
                w = Application(backend="win32").window(handle=hwnd)
                title = w.window_text().lower()
                if "decompress" in title or "decompressing" in title:
                    decompress_active = True
                    saw_decompress = True
                    break
            
            if saw_decompress and not decompress_active:
                print("  -> Decompression modal closed. Waiting for disk write stabilization...")
                break
        except Exception:
            pass

    # Phase 2: Actively monitor folder until file count completely stabilizes for 15 seconds
    stable_cycles = 0
    last_count = -1
    stabilize_start = time.time()

    while time.time() - stabilize_start < 90:
        time.sleep(3.0)
        current_segments = [
            p for p in target_dir.iterdir()
            if p.is_file() and p.suffix.lower() == ".dl" and p.stem.lower().startswith(base_stem) and re.search(r'_\d+$', p.stem)
        ]
        
        count = len(current_segments)
        if count > 0 and count == last_count:
            stable_cycles += 1
            # Requires 5 consecutive stable checks (15 seconds) with no new files appearing
            if stable_cycles >= 5:
                print(f"  -> Successfully verified all {count} segment files fully written to disk.")
                break
        else:
            stable_cycles = 0
            last_count = count

    kill_existing_holley()
    time.sleep(2.0)


def export_single_log(dl_file: Path, csv_target: Path) -> bool:
    min_valid_size = 2 * 1024 * 1024  # 2 MB threshold

    kill_existing_holley()

    if csv_target.exists():
        try:
            csv_target.unlink()
        except Exception:
            pass

    print(f"  -> Opening log part: {dl_file.name}...")
    proc = subprocess.Popen([HOLLEY_EXE, str(dl_file.resolve())])

    app = None
    log_win = None
    target_stem = dl_file.stem.lower()

    for _ in range(80):
        time.sleep(0.3)
        try:
            app = Application(backend="win32").connect(process=proc.pid, timeout=1)
            windows = app.windows()

            for w in windows:
                if not w.is_visible():
                    continue
                title = w.window_text().lower()
                if target_stem in title or "data logger" in title or "datalogger" in title:
                    log_win = w
                    break

            if log_win:
                break

            from pywinauto import findwindows
            for hwnd in findwindows.find_windows(visible=True):
                w = Application(backend="win32").window(handle=hwnd)
                title = w.window_text().lower()
                if target_stem in title or "data logger" in title:
                    log_win = w
                    app = Application(backend="win32").connect(handle=hwnd)
                    break

            if log_win:
                break
        except Exception:
            pass

    if not log_win:
        print(f"  [ERROR] Data Logger window could not be isolated for {dl_file.name}.")
        kill_existing_holley()
        return False

    try:
        log_win.restore()
        log_win.set_focus()
        time.sleep(0.8)

        log_win.click_input(coords=(25, 45))
        time.sleep(0.4)
        log_win.click_input(coords=(45, 185))
        time.sleep(1.0)

        dialog = None
        for _ in range(50):
            time.sleep(0.2)
            try:
                for w in app.windows():
                    if w.is_visible() and w.handle != log_win.handle:
                        w_title = w.window_text().lower()
                        if "save" in w_title or "export" in w_title or not w_title:
                            dialog = w
                            break
                if dialog:
                    break
            except Exception:
                pass

        if not dialog:
            print(f"  [ERROR] Export dialog popup not detected for {dl_file.name}.")
            kill_existing_holley()
            return False

        dialog.set_focus()
        time.sleep(0.4)
        dialog.type_keys("%n")
        time.sleep(0.2)
        dialog.type_keys("^a")
        time.sleep(0.1)
        dialog.type_keys("{DELETE}")
        time.sleep(0.1)
        dialog.type_keys(str(csv_target.resolve()), with_spaces=True)
        time.sleep(0.4)
        dialog.type_keys("{ENTER}")

        export_timeout = 120
        start_export = time.time()
        last_size = -1
        stable_size_counter = 0.0
        success = False

        while time.time() - start_export < export_timeout:
            time.sleep(1.5)
            if csv_target.exists():
                current_size = csv_target.stat().st_size
                if current_size > 0 and current_size == last_size:
                    stable_size_counter += 1.5
                else:
                    stable_size_counter = 0.0
                    last_size = current_size

                if stable_size_counter >= 4.5 and current_size >= min_valid_size:
                    success = True
                    break
            else:
                if time.time() - start_export > 40:
                    break

        kill_existing_holley()
        time.sleep(2.0)

        if success:
            print(
                f"  [SUCCESS] Created: {csv_target.name}"
                f" ({csv_target.stat().st_size // (1024 * 1024)} MB)"
            )
            return True
        else:
            print(f"  [FAILED] Export timed out or incomplete for {csv_target.name}.")
            return False

    except Exception as e:
        print(f"  [ERROR] Exception during export of {dl_file.name}: {e}.")
        kill_existing_holley()
        return False


def natural_sort_key(path):
    return [int(text) if text.isdigit() else text.lower() for text in re.split(r'(\d+)', path.name)]


def run_full_pipeline(target_dir: Path):
    if not target_dir.exists():
        print(f"[ERROR] Target directory does not exist: {target_dir}")
        return

    dlz_files = [p for p in target_dir.iterdir() if p.is_file() and p.suffix.lower() == ".dlz"]
    if not dlz_files:
        print("[INFO] No .dlz archives found in folder.")
        return

    for dlz_file in dlz_files:
        unpack_dlz_files(target_dir, dlz_file)

        min_valid_size = 2 * 1024 * 1024
        base_stem = dlz_file.stem.lower()

        dl_files = []
        for p in target_dir.iterdir():
            if p.is_file() and p.suffix.lower() == ".dl":
                if p.stem.lower().startswith(base_stem) and re.search(r'_\d+$', p.stem):
                    dl_files.append(p)

        if not dl_files:
            print(f"[ERROR] No segment files found for container {dlz_file.name}!")
            continue

        dl_files.sort(key=natural_sort_key)
        print(f"Verified {len(dl_files)} segment .dl files on disk ready for conversion.")

        missing_files = []
        for dl in dl_files:
            csv_path = target_dir / f"{dl.stem}.csv"
            if not csv_path.exists() or csv_path.stat().st_size < min_valid_size:
                missing_files.append(dl)

        if not missing_files:
            print(f"[INFO] All segments for {dlz_file.name} already have valid .csv counterparts!")
            continue

        total_files = len(dl_files)
        remaining_count = len(missing_files)
        print(f"Starting batch CSV conversion for {remaining_count} of {total_files} segments...")

        for index, dl_file in enumerate(missing_files, start=1):
            csv_target = target_dir / f"{dl_file.stem}.csv"
            print(f"\n----------------------------------------")
            print(f"[Progress: {index}/{remaining_count}] Converting: {dl_file.name}")
            print(f"----------------------------------------")

            success = False
            for attempt in range(1, 4):
                if attempt > 1:
                    print(f"  [RETRY] Attempt {attempt} for {dl_file.name}...")
                if export_single_log(dl_file, csv_target):
                    success = True
                    break
            
            if not success:
                print(f"  [WARNING] Skipping {dl_file.name} after 3 failed attempts, continuing batch...")


if __name__ == "__main__":
    run_full_pipeline(TARGET_FOLDER)
    print("\n[FINISHED] Full .dlz -> .dl -> .csv pipeline complete.")
